---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Privacy Policy: Data, Cookies, Ads & Analytics | SmartCalc',
  description: 'Privacy policy for SmartCalc calculators website.',
  canonicalPath: '/privacy-policy/',
};
---
<BaseLayout seo={seo}>
  <section class="card contentCard">
    <h1>Privacy Policy</h1>
    <p class="muted small">Last updated: {new Date().toISOString().slice(0, 10)}</p>
    <p>
      SmartCalc provides simple calculator tools. We do not ask for accounts or collect personal information directly.
    </p>

    <h2>What data we collect</h2>
    <p>
      Currently, SmartCalc does not collect account information because there are no signups/logins.
      Inputs you type into calculators are processed in your browser for the calculation and are not sent to us.
    </p>

    <h2>Cookies</h2>
    <p>
      We do not set any tracking cookies today. If/when ads or analytics are added, cookies may be used by those providers.
    </p>

    <h2>Analytics & Ads</h2>
    <p>
      We may add analytics and advertising (for example, Google AdSense) in the future. If/when we do, this page will be updated.
    </p>
    <h2>Contact</h2>
    <p>
      If you have questions, you can contact us from the Contact page.
    </p>
  </section>
</BaseLayout>

