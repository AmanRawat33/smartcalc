---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const seo = {
  title: 'GST Calculator India: Add/Remove GST (0–28%) | SmartCalc',
  description: 'GST calculator online India to add GST to base price or remove GST from inclusive price. Supports 0%, 5%, 12%, 18%, 28% rates.',
  canonicalPath: '/gst-calculator-india/',
};

const site = Astro.site?.toString() ?? 'https://example.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'GST Calculator Online India',
    applicationCategory: 'CalculatorApplication',
    operatingSystem: 'Any',
    url: `${site}/gst-calculator-india/`,
    description: seo.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How to add GST to a price?',
        acceptedAnswer: { '@type': 'Answer', text: 'Total = base × (1 + rate/100).' },
      },
      {
        '@type': 'Question',
        name: 'How to remove GST from an inclusive price?',
        acceptedAnswer: { '@type': 'Answer', text: 'Base = total ÷ (1 + rate/100).' },
      },
      {
        '@type': 'Question',
        name: 'What is GST inclusive vs exclusive price?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Exclusive means GST is added on top of the base price. Inclusive means the shown price already includes GST.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do you calculate GST amount?',
        acceptedAnswer: { '@type': 'Answer', text: 'GST amount = total − base (after adding/removing GST using the correct formula).' },
      },
      {
        '@type': 'Question',
        name: 'What are common GST rates in India?',
        acceptedAnswer: { '@type': 'Answer', text: 'Common slabs: 0%, 5%, 12%, 18%, and 28% (varies by goods/services).' },
      },
    ],
  },
];

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'GST Calculator (India)', path: '/gst-calculator-india/' },
];
---
<BaseLayout seo={seo} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <div class="layout">
    <article class="card contentCard">
      <Breadcrumbs items={breadcrumbs} />
      <h1>GST calculator online (India)</h1>
      <p>
        Add GST to a base amount, or remove GST from an inclusive amount.
      </p>

      <section class="card" style="padding: 14px; margin-top: 12px;">
        <div class="fieldRow">
          <div>
            <label for="mode">Mode</label>
            <select id="mode">
              <option value="add">Add GST (exclusive → inclusive)</option>
              <option value="remove">Remove GST (inclusive → exclusive)</option>
            </select>
          </div>
          <div>
            <label for="rate">GST rate</label>
            <select id="rate">
              <option value="0">0%</option>
              <option value="5">5%</option>
              <option value="12">12%</option>
              <option value="18" selected>18%</option>
              <option value="28">28%</option>
            </select>
          </div>
        </div>

        <div class="fieldRow" style="margin-top: 10px;">
          <div>
            <label for="amount">Amount</label>
            <input id="amount" inputmode="decimal" placeholder="e.g. 1000" />
          </div>
          <div>
            <label for="decimals">Decimals</label>
            <select id="decimals">
              <option value="0">0</option>
              <option value="2" selected>2</option>
              <option value="4">4</option>
            </select>
          </div>
        </div>

        <div style="display:flex; gap:10px; margin-top: 12px; flex-wrap:wrap;">
          <button id="calcBtn" type="button">Calculate GST</button>
          <button id="clearBtn" type="button" style="background: rgba(0,0,0,0.18); border-color: var(--border);">Clear</button>
        </div>

        <div id="result" class="result" aria-live="polite">
          <div class="muted small">Result will appear here.</div>
        </div>
      </section>

      <div style="margin-top: 12px;">
        <AdSlot label="In-content ad" height={250} />
      </div>

      <section style="margin-top: 18px;">
        <h2>Examples</h2>
        <div class="card" style="padding: 14px;">
          <p><strong>Add 18% GST to 1,000</strong> → GST 180, total 1,180.</p>
          <p><strong>Remove 18% GST from 1,180</strong> → base 1,000, GST 180.</p>
        </div>
      </section>

      <section class="faq" style="margin-top: 18px;">
        <h2>FAQ</h2>
        <h3>How to add GST to a price?</h3>
        <p>Total = base × (1 + rate/100).</p>

        <h3>How to remove GST from an inclusive price?</h3>
        <p>Base = total ÷ (1 + rate/100).</p>
      </section>

      <section style="margin-top: 18px;">
        <h2>What is a GST calculator?</h2>
        <p>
          A <strong>GST calculator</strong> helps you convert between <strong>base price</strong>, <strong>GST amount</strong>, and <strong>total price</strong>.
          In India, prices are commonly shown either as <strong>exclusive</strong> (GST added on top) or <strong>inclusive</strong> (GST already included).
          This tool supports both so you can calculate quickly and avoid billing mistakes.
        </p>

        <h2>What is GST in India?</h2>
        <p>
          <strong>GST</strong> (Goods and Services Tax) is an indirect tax used in India. On invoices you may see GST split into components like
          <strong>CGST</strong> + <strong>SGST</strong> (intra-state) or <strong>IGST</strong> (inter-state). This calculator computes the overall GST amount
          from the base/total; you can split it later as per invoice rules.
        </p>

        <h2>GST inclusive vs GST exclusive price</h2>
        <p>
          In real life, confusion usually comes from whether the price is <strong>inclusive</strong> or <strong>exclusive</strong> of GST:
          if you see a base price and GST is added at checkout or on an invoice line item, that’s <strong>exclusive</strong>.
          If you see a final price (MRP or “total”) where GST is already embedded, that’s <strong>inclusive</strong>.
          This page supports both scenarios so you can move between base, GST, and total without manual mistakes.
        </p>

        <h2>How to calculate GST online</h2>
        <p>
          If you have a base amount and want the total price, you <strong>add GST</strong>.
          If you have the final bill amount and want the original base amount, you <strong>remove GST</strong>.
          This tool supports the most common GST slabs: 0%, 5%, 12%, 18%, and 28%.
        </p>

        <h3>Step-by-step</h3>
        <div class="card" style="padding: 14px; margin-bottom: 10px;">
          <p><strong>1) Pick the correct GST rate</strong>: 0/5/12/18/28 (based on your invoice/product category).</p>
          <p><strong>2) Choose price type</strong>: base (exclusive) or total (inclusive).</p>
          <p><strong>3) Select mode</strong>: Add GST (exclusive → inclusive) or Remove GST (inclusive → exclusive).</p>
          <p><strong>4) Enter the amount</strong> and read base, GST and total.</p>
        </div>

        <h2>Common GST slabs (quick reference)</h2>
        <div class="card" style="padding: 14px; margin-bottom: 10px;">
          <p class="muted small" style="margin: 0;">
            0% · 5% · 12% · 18% · 28% — the applicable rate depends on the good/service category.
            Use the correct slab from your invoice/product category for accurate results.
          </p>
        </div>

        <h2>GST calculation formula</h2>
        <div class="card" style="padding: 14px; margin-bottom: 10px">
          <p><strong>Add GST</strong>: total = base × (1 + rate/100)</p>
          <p><strong>Remove GST</strong>: base = total ÷ (1 + rate/100)</p>
          <p><strong>GST amount</strong> = total − base</p>
        </div>

        <h2>Example GST calculation</h2>
        <div class="card" style="padding: 14px; margin-bottom: 10px;">
          <p><strong>Base ₹1000 @ 18% GST</strong></p>
          <p class="muted small" style="margin:0;">GST = 1000 × 18% = ₹180, Total = ₹1180</p>
        </div>

        <h2>Common mistakes (avoid them)</h2>
        <p>
          The most common manual error is removing GST by doing <em>GST = total × rate%</em>.
          That’s incorrect for inclusive prices because the GST is already embedded in the total.
          Use the “Remove GST” mode which divides by $(1 + rate/100)$ first.
        </p>

        <h2>When should you use this tool?</h2>
        <p>
          Use it when creating invoices/quotations, checking GST-inclusive totals, verifying MRP vs base price, or quickly auditing a bill.
          It’s also useful when you know only the total and need the base amount for bookkeeping.
        </p>

        <h2>Why use this GST calculator online?</h2>
        <p>
          It reduces calculation errors, especially when removing GST from an inclusive price (this is where most manual mistakes happen).
          Use it for invoicing, budgeting, and quick checks when you see GST-inclusive MRP or totals.
        </p>

        <h2>More FAQs</h2>
        <div class="card" style="padding: 14px;">
          <p><strong>How to calculate GST amount from base?</strong> Multiply base by rate% to get GST, then add to base.</p>
          <p><strong>How to calculate base price from total?</strong> Divide total by (1 + rate/100).</p>
          <p><strong>Which decimals should I use?</strong> Use 2 decimals for most billing; use more decimals for internal checks.</p>
        </div>
      </section>
    </article>

    <aside class="card asideCard">
      <AdSlot label="Sidebar ad" height={600} />
      <div class="card" style="padding: 12px; margin-top: 12px;">
        <strong>Try other tools</strong>
        <p class="muted small" style="margin-top: 8px;">
          <a href="/percentage-calculator/">Percentage calculator</a><br />
          <a href="/age-calculator/">Age calculator</a>
        </p>
      </div>
    </aside>
  </div>

  <script type="module">
    const $ = (id) => document.getElementById(id);
    const modeEl = $('mode');
    const rateEl = $('rate');
    const amountEl = $('amount');
    const decimalsEl = $('decimals');
    const resultEl = $('result');

    function parseNum(v) {
      if (!v) return NaN;
      const n = Number(String(v).replace(/,/g, ''));
      return Number.isFinite(n) ? n : NaN;
    }
    function fmt(n, decimals) {
      if (!Number.isFinite(n)) return '';
      return n.toLocaleString(undefined, { maximumFractionDigits: decimals, minimumFractionDigits: decimals });
    }
    function render(html) {
      resultEl.innerHTML = html;
      resultEl.classList.remove('fadeIn');
      void resultEl.offsetWidth;
      resultEl.classList.add('fadeIn');
    }

    function calc() {
      const mode = modeEl.value;
      const rate = parseNum(rateEl.value);
      const amount = parseNum(amountEl.value);
      const decimals = Number(decimalsEl.value || 2);

      if (!Number.isFinite(rate) || !Number.isFinite(amount)) {
        render('<div class="muted small">Enter a valid amount.</div>');
        return;
      }
      if (rate < 0) {
        render('<div class="muted small">Rate must be >= 0.</div>');
        return;
      }

      const r = rate / 100;
      if (mode === 'add') {
        const gst = amount * r;
        const total = amount + gst;
        render(`
          <div>
            <div><strong>Base:</strong> ${fmt(amount, decimals)}</div>
            <div><strong>GST (${fmt(rate, 0)}%):</strong> ${fmt(gst, decimals)}</div>
            <div style="margin-top:6px;"><strong>Total:</strong> ${fmt(total, decimals)}</div>
          </div>
        `);
      } else {
        const base = amount / (1 + r);
        const gst = amount - base;
        render(`
          <div>
            <div><strong>Total (inclusive):</strong> ${fmt(amount, decimals)}</div>
            <div><strong>Base (exclusive):</strong> ${fmt(base, decimals)}</div>
            <div style="margin-top:6px;"><strong>GST (${fmt(rate, 0)}%):</strong> ${fmt(gst, decimals)}</div>
          </div>
        `);
      }
    }

    $('calcBtn').addEventListener('click', calc);
    $('clearBtn').addEventListener('click', () => {
      amountEl.value = '';
      render('<div class="muted small">Result will appear here.</div>');
      amountEl.focus();
    });

    [modeEl, rateEl, amountEl, decimalsEl].forEach((el) => el.addEventListener('input', () => calc()));
  </script>
</BaseLayout>

