---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Contact SmartCalc: Feedback, Suggestions, Bug Reports',
  description: 'Contact SmartCalc for feedback, suggestions, or bug reports.',
  canonicalPath: '/contact/',
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact/' },
];
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs}>
  <section class="card contentCard">
    <h1>Contact</h1>
    <p>
      Send feedback, request a new calculator, or report an issue.
    </p>

    <h2>Email</h2>
    <div class="card" style="padding: 14px; margin-top: 12px;">
      <p class="muted small" style="margin: 0;">
        If you face any issue or have some suggestions, drop a mail to hello.simpletools@gmail.com
      </p>
    </div>

    <h2 style="margin-top: 18px;">What to include</h2>
    <p class="muted">
      To help us fix issues faster, include the calculator URL, the input values you used, and what output you expected.
    </p>

    <h2>Response time</h2>
    <p class="muted">
      We typically respond within 24–72 hours (depending on workload).
    </p>
  </section>
</BaseLayout>

