---
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'About – QuickTools',
  description: 'About QuickTools: fast, simple online calculators for everyday use.',
  canonicalPath: '/about/',
};

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs}>
  <section class="card contentCard">
    <h1>About QuickTools</h1>
    <p>
      QuickTools is a lightweight collection of online calculators built for speed and clarity. The goal is simple:
      provide useful tools that work well on mobile, load fast, and don’t overwhelm you with unnecessary steps.
    </p>
    <p>
      If you have a suggestion for a new calculator or want to report an issue, use the Contact page.
    </p>
    <p class="muted small">
      Tip: for better SEO and correct canonicals, set your domain in `SITE_URL` during deploy.
    </p>
    <p class="muted small" style="margin-top: 14px;">
      QuickTools is independently built and maintained to provide fast, free online calculators for everyday use.
    </p>
  </section>
</BaseLayout>

