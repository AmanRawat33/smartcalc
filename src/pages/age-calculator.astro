---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const seo = {
  title: 'Age Calculator Online by Date of Birth (DOB)',
  description: 'Age calculator online by date of birth. Calculate your exact age in years, months and days from DOB to today.',
  canonicalPath: '/age-calculator/',
};

const site = Astro.site?.toString() ?? 'https://example.com';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Age Calculator by Date of Birth',
    applicationCategory: 'CalculatorApplication',
    operatingSystem: 'Any',
    url: `${site}/age-calculator/`,
    description: seo.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the age calculator work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'It computes the difference between DOB and the “as of” date in calendar years, months and days.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I calculate age as of a past date?',
        acceptedAnswer: { '@type': 'Answer', text: 'Yes. Change the “as of date” to any date.' },
      },
    ],
  },
];

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Age Calculator', path: '/age-calculator/' },
];
---
<BaseLayout seo={seo} jsonLd={jsonLd} breadcrumbs={breadcrumbs}>
  <div class="layout">
    <article class="card contentCard">
      <Breadcrumbs items={breadcrumbs} />
      <h1>Age calculator online by date of birth</h1>
      <p>
        Enter your date of birth to calculate age in years, months and days (DOB → today).
      </p>

      <section class="card" style="padding: 14px; margin-top: 12px;">
        <div class="fieldRow">
          <div>
            <label for="dob">Date of birth</label>
            <input id="dob" type="date" />
          </div>
          <div>
            <label for="asOf">As of date</label>
            <input id="asOf" type="date" />
          </div>
        </div>

        <div style="display:flex; gap:10px; margin-top: 12px; flex-wrap:wrap;">
          <button id="calcBtn" type="button">Calculate age</button>
          <button id="todayBtn" type="button" style="background: rgba(0,0,0,0.18); border-color: var(--border);">Use today</button>
          <button id="clearBtn" type="button" style="background: rgba(0,0,0,0.18); border-color: var(--border);">Clear</button>
        </div>

        <div id="result" class="result" aria-live="polite">
          <div class="muted small">Result will appear here.</div>
        </div>
      </section>

      <div style="margin-top: 12px;">
        <AdSlot label="In-content ad" height={250} />
      </div>

      <section style="margin-top: 18px;">
        <h2>Example</h2>
        <div class="card" style="padding: 14px;">
          <p class="muted">
            If your DOB is 2000-01-01 and today is 2026-02-14, the calculator will show your age in years/months/days.
          </p>
        </div>
      </section>

      <section class="faq" style="margin-top: 18px;">
        <h2>FAQ</h2>
        <h3>How does the age calculator work?</h3>
        <p>It computes the difference between DOB and the “as of” date in calendar years, months and days.</p>

        <h3>Can I calculate age as of a past date?</h3>
        <p>Yes. Change the “as of date” to any date.</p>
      </section>

      <section style="margin-top: 18px;">
        <h2>What is an age calculator?</h2>
        <p>
          An <strong>age calculator</strong> converts your date of birth (DOB) into an exact age as of a selected date.
          Instead of only showing years, a good calculator also shows months and days, which is useful for forms,
          school admissions, jobs, insurance, and official documentation.
        </p>

        <h2>How to calculate age from date of birth</h2>
        <p>
          Age is a calendar difference. The usual method is to count full years first, then full months, then remaining days.
          This avoids common mistakes that happen when people divide total days by 365.
          If you choose a different “as of” date, the result updates instantly.
        </p>

        <h2>Why use this online age calculator?</h2>
        <p>
          It’s fast, works on mobile, and shows a clear breakdown: <strong>years, months, days</strong>.
          It also shows the total number of days and a next-birthday countdown, which users often search for.
        </p>
      </section>
    </article>

    <aside class="card asideCard">
      <AdSlot label="Sidebar ad" height={600} />
      <div class="card" style="padding: 12px; margin-top: 12px;">
        <strong>Try other tools</strong>
        <p class="muted small" style="margin-top: 8px;">
          <a href="/percentage-calculator/">Percentage calculator</a><br />
          <a href="/gst-calculator-india/">GST calculator India</a>
        </p>
      </div>
    </aside>
  </div>

  <script type="module">
    const $ = (id) => document.getElementById(id);
    const dobEl = $('dob');
    const asOfEl = $('asOf');
    const resultEl = $('result');

    function pad2(n) { return String(n).padStart(2, '0'); }
    function toISODate(d) { return `${d.getFullYear()}-${pad2(d.getMonth() + 1)}-${pad2(d.getDate())}`; }

    function parseDate(v) {
      if (!v) return null;
      const [y, m, d] = v.split('-').map(Number);
      if (!y || !m || !d) return null;
      // Use local date (avoid timezone shifts)
      return new Date(y, m - 1, d);
    }

    function render(html) {
      resultEl.innerHTML = html;
      resultEl.classList.remove('fadeIn');
      void resultEl.offsetWidth;
      resultEl.classList.add('fadeIn');
    }

    // Calculate calendar diff in years, months, days
    function diffYMD(from, to) {
      let y = to.getFullYear() - from.getFullYear();
      let m = to.getMonth() - from.getMonth();
      let d = to.getDate() - from.getDate();

      if (d < 0) {
        // borrow days from previous month
        const prevMonth = new Date(to.getFullYear(), to.getMonth(), 0);
        d += prevMonth.getDate();
        m -= 1;
      }
      if (m < 0) {
        m += 12;
        y -= 1;
      }
      return { y, m, d };
    }

    function calc() {
      const dob = parseDate(dobEl.value);
      const asOf = parseDate(asOfEl.value);

      if (!dob || !asOf) {
        render('<div class="muted small">Select both DOB and “as of” date.</div>');
        return;
      }
      if (asOf < dob) {
        render('<div class="muted small">“As of” date must be on/after DOB.</div>');
        return;
      }

      const { y, m, d } = diffYMD(dob, asOf);
      const totalDays = Math.floor((asOf - dob) / (24 * 60 * 60 * 1000));

      // next birthday
      const nextBdayYear = (asOf.getMonth() > dob.getMonth() || (asOf.getMonth() === dob.getMonth() && asOf.getDate() > dob.getDate()))
        ? asOf.getFullYear() + 1
        : asOf.getFullYear();
      const nextBday = new Date(nextBdayYear, dob.getMonth(), dob.getDate());
      const daysToBday = Math.ceil((nextBday - asOf) / (24 * 60 * 60 * 1000));

      render(`
        <div>
          <div><strong>Age:</strong> ${y} years, ${m} months, ${d} days</div>
          <div class="muted small" style="margin-top:6px;">Total: ${totalDays.toLocaleString()} days</div>
          <div class="muted small" style="margin-top:6px;">Next birthday: ${toISODate(nextBday)} (${daysToBday} day(s) remaining)</div>
        </div>
      `);
    }

    $('todayBtn').addEventListener('click', () => {
      const now = new Date();
      asOfEl.value = toISODate(now);
      calc();
    });
    $('calcBtn').addEventListener('click', calc);
    $('clearBtn').addEventListener('click', () => {
      dobEl.value = '';
      asOfEl.value = toISODate(new Date());
      render('<div class="muted small">Result will appear here.</div>');
      dobEl.focus();
    });

    // defaults
    asOfEl.value = toISODate(new Date());
    [dobEl, asOfEl].forEach((el) => el.addEventListener('input', () => calc()));
  </script>
</BaseLayout>

