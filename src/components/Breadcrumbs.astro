---
type Crumb = { name: string; path: string };
const { items } = Astro.props as { items: Crumb[] };
---
<nav aria-label="Breadcrumb" class="muted small" style="margin-bottom: 10px;">
  {items.map((c, idx) => (
    <>
      <a href={c.path}>{c.name}</a>
      {idx < items.length - 1 ? <span aria-hidden="true"> / </span> : null}
    </>
  ))}
</nav>

